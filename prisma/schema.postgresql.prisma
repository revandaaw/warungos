// WarungOS Database Schema - Production PostgreSQL (Neon)
// Used when deploying to Neon / Render / Vercel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenantUsers     TenantUser[]
  stockMovements  StockMovement[]
  sales           Sale[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  businessType String       @default("Warung Kelontong")
  city         String       @default("Jakarta")
  timezone     String       @default("Asia/Jakarta")
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenantUsers     TenantUser[]
  categories      Category[]
  products        Product[]
  stockMovements  StockMovement[]
  sales           Sale[]
  saleItems       SaleItem[]
  payments        Payment[]
  auditLogs       AuditLog[]

  @@map("tenants")
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      String   @default("OWNER")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

model Category {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id           String          @id @default(uuid())
  tenantId     String
  categoryId   String?
  name         String
  sku          String?
  unit         String          @default("pcs")
  costPrice    Decimal         @default(0) @db.Decimal(12, 2)
  sellPrice    Decimal         @default(0) @db.Decimal(12, 2)
  stockBalance Decimal         @default(0) @db.Decimal(12, 2)
  minStock     Decimal         @default(0) @db.Decimal(12, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  saleItems    SaleItem[]

  @@index([tenantId])
  @@index([tenantId, sku])
  @@index([categoryId])
  @@map("products")
}

model StockMovement {
  id            String   @id @default(uuid())
  tenantId      String
  productId     String
  movementType  String
  quantity      Decimal  @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  reason        String?
  createdBy     String?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  creator       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@map("stock_movements")
}

model Sale {
  id            String     @id @default(uuid())
  tenantId      String
  receiptNo     String
  cashierId     String
  status        String     @default("COMPLETED")
  subtotal      Decimal    @default(0) @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal    @default(0) @db.Decimal(12, 2)
  paidTotal     Decimal    @default(0) @db.Decimal(12, 2)
  changeTotal   Decimal    @default(0) @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())
  voidedAt      DateTime?

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashier       User       @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items         SaleItem[]
  payments      Payment[]

  @@unique([tenantId, receiptNo])
  @@index([tenantId])
  @@index([cashierId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(uuid())
  tenantId            String
  saleId              String
  productId           String
  productNameSnapshot String
  qty                 Decimal  @db.Decimal(12, 2)
  costPriceSnapshot   Decimal  @db.Decimal(12, 2)
  sellPriceSnapshot   Decimal  @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  saleId    String
  method    String   @default("CASH")
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  paidAt    DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
